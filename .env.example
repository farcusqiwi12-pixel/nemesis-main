# Local development
DATABASE_URL=postgres://nemesis:nemesis@localhost:5432/nemesis
# Optional: Redis is not required. The app has an in-memory fallback.
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_a_long_random_string
PORT=3000

# Optional: creates/updates the built-in developer account during bootstrap
DEVELOPER_PASSWORD=change_this_to_a_strong_password
